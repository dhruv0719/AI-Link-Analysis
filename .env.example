# ---------------------------------------------------------------------------
# Copy to .env and fill in ONE provider key. Never commit .env.
# ---------------------------------------------------------------------------

# Which LLM does the analysis: openai | anthropic | gemini | groq
LLM_PROVIDER=openai
# Leave empty to use the provider default:
#   openai -> gpt-6-luna | anthropic -> claude-haiku-5-5 | gemini -> gemini-3.5-flash-lite | groq -> openai/gpt-oss-120b
LLM_MODEL=

# Optional fallback used when the primary provider errors or returns invalid JSON
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# OpenAI reasoning models only (gpt-5.6 / gpt-6 family). Leave empty for non-reasoning models.
OPENAI_REASONING_EFFORT=low
# Gemini only (minimal | low | medium | high). Empty = model default.
GEMINI_THINKING_LEVEL=

LLM_MAX_OUTPUT_TOKENS=8000
LLM_TIMEOUT_SECONDS=90

# --- Website fetching -------------------------------------------------------
FETCH_TIMEOUT_SECONDS=12
FETCH_MAX_BYTES=2000000
MAX_REDIRECTS=5
MAX_EXTRA_PAGES=3          # extra same-site pages (about / services / pricing ...)
MAX_CONTENT_CHARS=20000    # text budget sent to the LLM (~5k tokens)

# --- Caching / protection ---------------------------------------------------
CACHE_TTL_SECONDS=86400
CACHE_MAX_ITEMS=256
RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY_HEADERS=false  # set true behind Render/Heroku/Nginx so the real client IP is used
VERIFY_COMPETITORS=true
CORS_ORIGINS=*

# DEV/TEST ONLY: allow localhost / private IPs. Never enable in production.
ALLOW_PRIVATE_URLS=false
